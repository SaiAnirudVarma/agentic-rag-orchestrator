# Copy to .env and adjust for your environment.

APP_NAME="Agentic RAG Orchestrator"
ENVIRONMENT=development
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_MAX_CONNECTIONS=20

MCP_SERVER_NAME=agentic-rag-mcp-server
MCP_PROTOCOL_VERSION=2024-11-05
MCP_HANDSHAKE_TIMEOUT_SECONDS=5.0

SANDBOX_EXECUTION_ENABLED=true
SANDBOX_NAMESPACE=agentic-rag-sandbox
